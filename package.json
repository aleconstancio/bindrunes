{
	"name": "bindrunes-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*",
		"examples/*",
		"templates/*",
		"docs-site"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint -- --write .",
		"test": "turbo run test",
		"test:ci": "turbo run test:ci",
		"test:watch": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"check": "turbo run check",
		"validate": "bun run build && bun run lint && bun run check && bun run test:ci && bun run size",
		"changeset": "changeset",
		"release:version": "changeset version",
		"release:publish": "changeset publish",
		"prepare": "husky",
		"size": "size-limit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@size-limit/preset-small-lib": "^12.1.0",
		"@types/react": "^19.0.0",
		"docs-site": "^0.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"madge": "^8.0.0",
		"size-limit": "^12.1.0",
		"turbo": "^2.10.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"biome check --write"
		],
		"*.{json,css}": [
			"biome check --write"
		]
	},
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=20.0.0"
	}
}
