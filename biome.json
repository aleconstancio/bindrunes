{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**",
			"!**/.worktrees",
			"!**/.svelte-kit",
			"!**/dist",
			"!**/node_modules",
			"!**/coverage",
			"!examples",
			"!src/styles/tokens/tailwind.css",
			"!src/styles/tokens.example.css",
			"!src/components/scaffold/app.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "warn",
				"noUnusedVariables": "warn"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"useIterableCallbackReturn": "warn"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useNodejsImportProtocol": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			},
			"formatter": {
				"indentStyle": "tab"
			}
		},
		{
			"includes": ["**/*.json"],
			"formatter": {
				"indentStyle": "tab"
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": true
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.svelte.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"useIterableCallbackReturn": "off",
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
