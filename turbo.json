{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"persistent": true
		},
		"lint": {
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"test:ci": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"check": {
			"dependsOn": ["build"],
			"outputs": []
		}
	}
}
