{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"persistent": true
		},
		"lint": {},
		"test": {
			"dependsOn": ["build"]
		},
		"test:ci": {
			"dependsOn": ["build"]
		},
		"check": {
			"dependsOn": ["build"]
		},
		"validate": {
			"dependsOn": ["build"]
		}
	}
}
