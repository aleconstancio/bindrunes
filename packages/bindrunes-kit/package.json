{
	"name": "bindrunes-kit",
	"version": "1.0.0",
	"description": "SvelteKit meta-framework extension for urupe-ui — SSR, auth, i18n, adapters",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aleconstancio/urupe-ui.git",
		"directory": "packages/bindrunes-kit"
	},
	"homepage": "https://github.com/aleconstancio/urupe-ui#readme",
	"bugs": {
		"url": "https://github.com/aleconstancio/urupe-ui/issues"
	},
	"files": [
		"dist",
		"src",
		"templates"
	],
	"bin": {
		"create-bindrunes": "./src/cli/index.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"default": "./src/server/index.ts"
		},
		"./client": {
			"types": "./src/client/index.ts",
			"default": "./src/client/index.ts"
		},
		"./adapters": {
			"types": "./src/adapters/index.ts",
			"default": "./src/adapters/index.ts"
		},
		"./cli": {
			"types": "./src/cli/index.ts",
			"default": "./src/cli/index.ts"
		}
	},
	"scripts": {
		"build": "echo 'workspace package - no build needed'",
		"dev": "echo 'workspace package - no build needed'",
		"lint": "biome check .",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:ci": "vitest run --coverage --reporter=verbose"
	},
	"dependencies": {
		"urupe-ui": "workspace:*",
		"valibot": "^1.4.1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"@sveltejs/kit": "^2.0.0",
		"vite": "^8.1.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"happy-dom": "^20.10.6",
		"typescript": "^7.0.2",
		"@vitest/coverage-v8": "^4.1.9",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
