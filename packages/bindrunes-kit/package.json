{
	"name": "bindrunes-kit",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"license": "MIT",
	"bin": {
		"create-bindrunes": "./src/cli/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"default": "./dist/cli/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check .",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"bindrunes": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"typescript": "^6.0.3"
	},
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=20.0.0"
	}
}
