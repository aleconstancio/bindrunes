{
	"compilerOptions": {
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"target": "esnext"
	},
	"include": ["src/**/*"]
}
