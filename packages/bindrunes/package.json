{
	"name": "bindrunes",
	"version": "4.1.0",
	"description": "Svelte 5 component library for B2B SaaS applications — 234 components, 25 composables, three-axis design system",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aleconstancio/bindrunes.git",
		"directory": "packages/bindrunes"
	},
	"homepage": "https://bindrunes.dev",
	"bugs": {
		"url": "https://github.com/aleconstancio/bindrunes/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"component-library",
		"design-system",
		"tailwind",
		"tailwindcss",
		"b2b",
		"saas",
		"ssr",
		"oklch",
		"ui",
		"reactive",
		"composable",
		"agentic",
		"copilot",
		"llm"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"svelte": "./dist/data/index.js",
			"default": "./dist/data/index.js"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"svelte": "./dist/forms/index.js",
			"default": "./dist/forms/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"svelte": "./dist/auth/index.js",
			"default": "./dist/auth/index.js"
		},
		"./layouts": {
			"types": "./dist/layouts/index.d.ts",
			"svelte": "./dist/layouts/index.js",
			"default": "./dist/layouts/index.js"
		},
		"./domains/*": {
			"types": "./dist/domains/*/index.d.ts",
			"svelte": "./dist/domains/*/index.js",
			"default": "./dist/domains/*/index.js"
		},
		"./i18n/*": {
			"types": "./dist/i18n/*.d.ts",
			"svelte": "./dist/i18n/*.js",
			"default": "./dist/i18n/*.js"
		},
		"./tailwind": {
			"types": "./dist/tailwind-plugin.d.ts",
			"default": "./dist/tailwind-plugin.js"
		},
		"./styles/*": {
			"default": "./src/styles/*"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./responsive": {
			"types": "./dist/utils/useViewport.svelte.d.ts",
			"svelte": "./dist/utils/useViewport.svelte.js",
			"default": "./dist/utils/useViewport.svelte.js"
		},
		"./playground": {
			"types": "./dist/playground/index.d.ts",
			"svelte": "./dist/playground/index.js",
			"default": "./dist/playground/index.js"
		},
		"./playground/app.css": "./dist/playground/app.css",
		"./playground/*": {
			"types": "./dist/playground/*.d.ts",
			"svelte": "./dist/playground/*.svelte",
			"default": "./dist/playground/*.js"
		},
		"./agentic": {
			"types": "./dist/utils/agentic/index.d.ts",
			"svelte": "./dist/utils/agentic/index.js",
			"default": "./dist/utils/agentic/index.js"
		},
		"./motion": {
			"types": "./dist/utils/motion/index.d.ts",
			"svelte": "./dist/utils/motion/index.js",
			"default": "./dist/utils/motion/index.js"
		}
	},
	"files": [
		"dist",
		"src/styles",
		"README.md"
	],
	"sideEffects": [
		"**/*.css",
		"./src/styles/**"
	],
	"peerDependencies": {
		"lucide-svelte": "^1.0.1",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.0.0",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"lucide-svelte": {
			"optional": true
		},
		"mode-watcher": {
			"optional": true
		},
		"svelte-sonner": {
			"optional": true
		}
	},
	"dependencies": {
		"@bindrunes/tokens": "workspace:*",
		"bits-ui": "^2.18.1",
		"dompurify": "^3.4.11",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@internationalized/date": "^3.12.2",
		"@storybook/addon-a11y": "^8.6.0",
		"@storybook/addon-essentials": "^8.6.0",
		"@storybook/addon-themes": "^8.6.0",
		"@storybook/addon-viewport": "^8.6.0",
		"@storybook/svelte": "^8.6.0",
		"@storybook/svelte-vite": "^8.6.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.0.1",
		"@vitest/coverage-v8": "^4.1.9",
		"happy-dom": "^20.10.6",
		"storybook": "^10.5.0",
		"svelte": "^5.56.4",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"vitest-axe": "^0.1.0"
	},
	"optionalDependencies": {
		"@microsoft/fetch-event-source": "^2.0.1",
		"chart.js": "^4.5.1",
		"localforage": "^1.10.0",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-history": "^1.5.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.13.4",
		"prosemirror-model": "^1.25.9",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.9",
		"svelte-chartjs": "^4.0.1"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "svelte-package -i src -o dist -w",
		"dev:test": "vitest",
		"clean": "rm -rf dist .svelte-kit",
		"build": "svelte-package -i src -o dist && node scripts/build-clean.mjs",
		"build:clean": "node scripts/build-clean.mjs",
		"prepublishOnly": "bun run build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run --coverage --reporter=verbose",
		"test:watch:coverage": "vitest --coverage",
		"check": "tsc --noEmit",
		"validate": "bun run lint && bun run check && bun run test",
		"validate:contrast": "bun run test src/utils/contrastCheck.test.ts src/utils/themeContrast.test.ts",
		"changeset": "changeset",
		"release:version": "changeset version",
		"release:publish": "changeset publish",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	}
}
